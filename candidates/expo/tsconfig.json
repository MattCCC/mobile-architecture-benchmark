{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@mobilebench/rn-ui": ["../_rn-shared/ui/src"],
      "@mobilebench/rn-benchkit": ["../_rn-shared/rn-benchkit/src"],
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../_rn-shared/ui/src/**/*.ts",
    "../_rn-shared/ui/src/**/*.tsx",
    "../_rn-shared/rn-benchkit/src/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "android", "ios", ".mb-assets"]
}
