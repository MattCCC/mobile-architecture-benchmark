{
  "name": "mobilebench-island-rn",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "React Native islands (Detail, Insights) packaged with React Native Brownfield as an Android AAR and an iOS XCFramework for the shared island host",
  "scripts": {
    "test": "node --test ../../_island-rn-ui/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config .eslintrc.js index.js BuildProbe.ts '../../_island-rn-ui/src/**/*.{ts,tsx}' '../../_island-rn-ui/benchkit/src/**/*.ts'",
    "package:android": "brownfield package:android",
    "package:ios": "brownfield package:ios --add-spm-package"
  },
  "dependencies": {
    "@callstack/brownfield-cli": "6.0.1",
    "@callstack/react-native-brownfield": "6.0.1",
    "@mobilebench/rn-benchkit": "file:../../_island-rn-ui/benchkit",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/react": "19.3.0",
    "eslint": "8.57.1",
    "prettier": "2.8.8",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
