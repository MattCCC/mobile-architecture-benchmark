{
  "compilerOptions": {
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "rootDir": ".",
    "outDir": "build/test"
  },
  "include": ["app/core/**/*.ts", "test/**/*.ts"]
}
