# NativeScript candidate: make targets (design §14.2). Included by the root Makefile with
#   -include $(wildcard candidates/*/candidate.mk)
# and usable on its own:  make -f candidates/nativescript/candidate.mk check-nativescript
# GNU Make 3.81 compatible: no .ONESHELL, $(file ...), ::=, !=, undefine or pattern rules.

MB_CANDIDATES += nativescript

# Absolute, so recipes never act on relative paths (abspath and lastword exist since GNU Make 3.81).
MB_NATIVESCRIPT_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))

# Toolchain environment (decision 15 paths as overridable defaults; nothing is installed by these targets).
MB_NATIVESCRIPT_JDK17_DEFAULT := /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
MB_NATIVESCRIPT_JAVA_HOME ?= $(if $(wildcard $(MB_NATIVESCRIPT_JDK17_DEFAULT)),$(MB_NATIVESCRIPT_JDK17_DEFAULT),$(JAVA_HOME))
MB_NATIVESCRIPT_ANDROID_HOME ?= $(if $(ANDROID_HOME),$(ANDROID_HOME),$(HOME)/Library/Android/sdk)
# The CLI merges App_Resources/iOS/build.xcconfig with Ruby's xcodeproj gem; Homebrew's CocoaPods keg ships it.
# Ruby's own gem path stays on GEM_PATH, so `pod --version` (part of the CLI's environment check) keeps working.
MB_NATIVESCRIPT_GEM_PATH ?= $(shell brew --prefix cocoapods 2>/dev/null)/libexec:$(shell gem env gempath 2>/dev/null)

# Android ABIs of the measurement build (design §13.1); CI acceptance builds pass x86_64.
MB_NATIVESCRIPT_ABIS ?= arm64-v8a

# Release signing: properties file with storeFile, storePassword, keyAlias, keyPassword. Defaults to a local,
# non-distribution key generated by keystore-nativescript (gitignored, never committed).
MB_NATIVESCRIPT_KEYSTORE_PROPERTIES ?= $(MB_NATIVESCRIPT_DIR)/build/keys/local-release.properties

MB_NATIVESCRIPT_APK := $(MB_NATIVESCRIPT_DIR)/build/android/app-arm64-release.apk
MB_NATIVESCRIPT_IOS_APP := $(MB_NATIVESCRIPT_DIR)/build/ios/MBNativeScript.app

MB_NATIVESCRIPT_ANDROID_ENV = export JAVA_HOME="$(MB_NATIVESCRIPT_JAVA_HOME)" ANDROID_HOME="$(MB_NATIVESCRIPT_ANDROID_HOME)" && \
	export PATH="$$JAVA_HOME/bin:$$ANDROID_HOME/platform-tools:$$PATH"

.PHONY: deps-nativescript check-nativescript prepare-nativescript keystore-nativescript \
	build-nativescript-android build-nativescript-ios clean-nativescript \
	artifacts-nativescript-android artifacts-nativescript-ios

# Dependency install from the committed lockfile (public registry, pinned in the candidate's .npmrc).
deps-nativescript:
	cd "$(MB_NATIVESCRIPT_DIR)" && npm ci --no-audit --no-fund

# Type-check, lint and unit tests; no app build, no device.
check-nativescript:
	cd "$(MB_NATIVESCRIPT_DIR)" && npm run typecheck && npm run lint && npm test

# Verified fixture copies and the golden-checked replay stream (app/generated, Android assets).
prepare-nativescript:
	cd "$(MB_NATIVESCRIPT_DIR)" && node scripts/prepare-assets.mjs

# Local, non-distribution release key (random password), only if no properties file exists yet.
keystore-nativescript:
	@props="$(MB_NATIVESCRIPT_KEYSTORE_PROPERTIES)"; \
	if [ -f "$$props" ]; then echo "keystore: using $$props"; exit 0; fi; \
	$(MB_NATIVESCRIPT_ANDROID_ENV) && \
	mkdir -p "$$(dirname "$$props")" && dir=$$(cd "$$(dirname "$$props")" && pwd) && chmod 700 "$$dir" && \
	pw=$$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n') && \
	keytool -genkeypair -noprompt -keystore "$$dir/local-release.jks" -storetype PKCS12 -alias mobilebench \
		-keyalg RSA -keysize 2048 -validity 3650 -dname "CN=mobilebench local" \
		-storepass "$$pw" -keypass "$$pw" >/dev/null && \
	printf 'storeFile=%s\nstorePassword=%s\nkeyAlias=mobilebench\nkeyPassword=%s\n' "$$dir/local-release.jks" "$$pw" "$$pw" > "$$props" && \
	chmod 600 "$$props" "$$dir/local-release.jks" && echo "keystore: created $$props"

# Release APK (webpack production mode with Terser, R8 on, single ABI), signed with the local key.
build-nativescript-android: prepare-nativescript keystore-nativescript
	@props="$(MB_NATIVESCRIPT_KEYSTORE_PROPERTIES)"; \
	ks=$$(sed -n 's/^storeFile=//p' "$$props"); pw=$$(sed -n 's/^storePassword=//p' "$$props"); \
	al=$$(sed -n 's/^keyAlias=//p' "$$props"); kpw=$$(sed -n 's/^keyPassword=//p' "$$props"); \
	case "$$ks" in /*) ;; *) ks="$$(pwd)/$$ks" ;; esac; \
	$(MB_NATIVESCRIPT_ANDROID_ENV) && cd "$(MB_NATIVESCRIPT_DIR)" && mkdir -p build/android && \
	echo "ns build android --release (abis $(MB_NATIVESCRIPT_ABIS); signing arguments not echoed)" && \
	npx --no-install ns build android --release --gradle-args="-PmbAbis=$(MB_NATIVESCRIPT_ABIS)" \
		--key-store-path "$$ks" --key-store-password "$$pw" --key-store-alias "$$al" --key-store-alias-password "$$kpw" \
		--copy-to build/android/app-arm64-release.apk && \
	ls -l build/android/app-arm64-release.apk

# Release build for the iOS simulator (no signing). Device builds need a team in build.xcconfig (local only).
build-nativescript-ios: prepare-nativescript
	cd "$(MB_NATIVESCRIPT_DIR)" && \
	export GEM_PATH="$(MB_NATIVESCRIPT_GEM_PATH)" && \
	npx --no-install ns build ios --release && \
	app=$$(ls -d platforms/ios/build/Release-iphonesimulator/*.app | head -1) && \
	test -n "$$app" && rm -rf "$(MB_NATIVESCRIPT_IOS_APP)" && mkdir -p "$(MB_NATIVESCRIPT_DIR)/build/ios" && \
	cp -R "$$app" "$(MB_NATIVESCRIPT_IOS_APP)" && du -sk "$(MB_NATIVESCRIPT_IOS_APP)"

clean-nativescript:
	test -f "$(MB_NATIVESCRIPT_DIR)/candidate.json" && cd "$(MB_NATIVESCRIPT_DIR)" && \
	rm -rf "$(MB_NATIVESCRIPT_DIR)/platforms" "$(MB_NATIVESCRIPT_DIR)/build" "$(MB_NATIVESCRIPT_DIR)/app/generated" \
		"$(MB_NATIVESCRIPT_DIR)/App_Resources/Android/src/main/assets/mobilebench"

artifacts-nativescript-android:
	@if [ -f "$(MB_NATIVESCRIPT_APK)" ]; then echo "$(MB_NATIVESCRIPT_APK)"; else echo "not-verified: not-built ($(MB_NATIVESCRIPT_APK))" >&2; exit 1; fi

artifacts-nativescript-ios:
	@if [ -d "$(MB_NATIVESCRIPT_IOS_APP)" ]; then echo "$(MB_NATIVESCRIPT_IOS_APP)"; else echo "not-verified: not-built ($(MB_NATIVESCRIPT_IOS_APP))" >&2; exit 1; fi
