<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Process-start hook: captures the launching Intent extras (launch configuration), the saved-state flag
         of the first activity, foreground/background transitions and the accessibility state. -->
    <provider
      android:name="org.example.mobilebench.benchkit.BenchKitInitProvider"
      android:authorities="${applicationId}.mobilebench.benchkit"
      android:exported="false" />
  </application>
</manifest>
